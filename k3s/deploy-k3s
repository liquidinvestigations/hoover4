#!/usr/bin/env python3
"""Install, update, start, stop and check a k3s site of Hoover and openDesk. Standard library only.

Usage:
  deploy-k3s render    --target NODE... [--manifests]                    print the configuration. Changes no host.
  deploy-k3s check     --target NODE...                                  check the hosts and the site. Changes no host.
  deploy-k3s up        --target NODE... [--steps STEP...] [--start]
  deploy-k3s up        --resume RECORD
  deploy-k3s down      --target NODE... [--steps STEP...]
  deploy-k3s down      --resume RECORD
  deploy-k3s status    [RECORD]                                          print the records
  deploy-k3s measure-speed --target NODE...                              measure the CPU and disk speeds again
  deploy-k3s import-compose <zone> <folder> --home NODE --ini FILE [...] import a stopped Compose install into a new zone

--target names nodes of the site file, or `all`. Every command except status and import-compose needs it.
--site names the site file, a YAML Ansible inventory (config.py). Without it, $HOOVER4_SITE names it. Every command
needs one of them. The state folder of the site is beside the site file and has the name of the file without its
extension. Each command first prints the site id, the site file and the state folder.
--ask-become-pass asks once for the sudo password of the nodes. Without it, the nodes need sudo without a password.
Every step runs the scripts of this checkout. The record keeps the commit of HEAD and `git status --porcelain` of the
checkout. A resume needs the same commit.
up installs or updates the hosts, k3s, the registry, the images, the platform services and the zones, in this order.
up --start starts what down stopped: k3s, then the stores, Temporal, the applications and the ingress.
down stops the ingress, the applications and workers, Temporal, the stores, and then k3s. It cancels no workflow.
--steps runs only the named steps of the plan. render prints the plan.
The cluster holds the zone state, the zone secrets and the operator state (clusterstate.py). Each command reads the
cluster copy into the state folder first, and up and down write the changes back after each step.
A failed or stopped run keeps its record. `up --resume RECORD` continues at the first unfinished step.
measure-speed measures the CPU speed and the write speed of each storage tier of the nodes, and keeps them in speed/
of the state folder. up measures a new node once before k3s starts, and then uses the stored values. Stop k3s and every
container of a node before its measure-speed: it refuses a node where k3s or a container runs, or whose 1-minute load
is above 5. The next up gives the new speed factor to k3s.
import-compose runs import_compose/import_compose.py with the commit of HEAD. `deploy-k3s import-compose --help` names
its arguments and steps. It runs once per zone.

The command runs in the operator image (images/operator/). This file builds the image with podman, else docker, when
its inputs changed, and runs one container with --rm. The container mounts this checkout read-only, the folder of
the site file read-write, ~/.ssh read-only and the SSH agent socket, and runs with the UID of the user and the network
of the host. Its HOME is /tmp/home of the container, so no tool writes into the checkout. Ansible writes new host keys
into known_hosts of the state folder. The step images builds the image of the operator pod on this image.

A copy of this file outside a checkout first clones the repository:
  deploy-k3s --checkout DIR [--repository URL] <command> ...
It then runs the deploy-k3s of that checkout with the other arguments.
"""
import hashlib
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPOSITORY = 'https://github.com/liquidinvestigations/hoover4'
# The inputs of the operator image. A change of one of them builds a new image.
IMAGE_INPUTS = ('images/operator/Containerfile', 'images/operator/requirements.txt', 'ansible/requirements.yml')
IMAGE = 'localhost/hoover4-operator'
IN_IMAGE = 'HOOVER4_OPERATOR_IMAGE'


def bootstrap_checkout(argv):
    """Clone the repository when this file is not inside a checkout, and run the deploy-k3s of the checkout."""
    if (HERE / 'driver' / 'deploy.py').exists():
        return argv
    if '--checkout' not in argv:
        raise SystemExit('this deploy-k3s is outside a hoover4 checkout. Give --checkout DIR.')
    i = argv.index('--checkout')
    checkout = Path(argv[i + 1]).expanduser()
    rest = argv[:i] + argv[i + 2:]
    url = REPOSITORY
    if '--repository' in rest:
        j = rest.index('--repository')
        url = rest[j + 1]
        rest = rest[:j] + rest[j + 2:]
    if not (checkout / '.git').exists():
        subprocess.run(['git', 'clone', url, str(checkout)], check=True)
    os.execv(sys.executable, [sys.executable, str(checkout / 'k3s' / 'deploy-k3s'), *rest])


def site_argument(argv):
    """The absolute path of the site file of the command line, else of $HOOVER4_SITE."""
    value = os.environ.get('HOOVER4_SITE', '')
    for i, arg in enumerate(argv):
        if arg == '--site' and i + 1 < len(argv):
            value = argv[i + 1]
        elif arg.startswith('--site='):
            value = arg.split('=', 1)[1]
    if not value:
        raise SystemExit('deploy-k3s: give the site file with --site FILE, or set HOOVER4_SITE.')
    path = Path(value).expanduser().resolve()
    if not path.is_file():
        raise SystemExit(f'deploy-k3s: the site file {path} does not exist.')
    return path


def image_digest():
    digest = hashlib.sha256()
    for name in IMAGE_INPUTS:
        digest.update(name.encode() + b'\0' + (HERE / name).read_bytes() + b'\0')
    return digest.hexdigest()[:16]


def engine():
    for name in ('podman', 'docker'):
        if shutil.which(name):
            return name
    raise SystemExit('deploy-k3s needs podman or docker on this host.')


def ensure_image(tool):
    """Build the operator image when no image has the digest of its inputs. Return the image name."""
    name = f'{IMAGE}:{image_digest()}'
    if subprocess.run([tool, 'image', 'inspect', name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        return name
    print(f'deploy-k3s: build the operator image {name}', file=sys.stderr, flush=True)
    with tempfile.TemporaryDirectory(prefix='hoover4-operator-') as context:
        for item in IMAGE_INPUTS:
            shutil.copy(HERE / item, Path(context) / Path(item).name)
        code = subprocess.run([tool, 'build', '-t', name, '-f', str(Path(context) / 'Containerfile'), context]).returncode
    if code:
        raise SystemExit(f'deploy-k3s: the build of the operator image failed with exit code {code}.')
    return name


def run_in_image(argv):
    """Run this command in the operator image and return its exit code."""
    site = site_argument(argv)
    tool = engine()
    image = ensure_image(tool)
    repo = HERE.parent
    home = Path.home()
    uid, gid = os.getuid(), os.getgid()
    user = os.environ.get('USER') or 'operator'
    work = Path(tempfile.mkdtemp(prefix='hoover4-operator-run-'))
    try:
        # ssh needs a passwd entry for the UID, and the home folder of that entry holds ~/.ssh.
        (work / 'passwd').write_text(f'root:x:0:0:root:/root:/bin/sh\n{user}:x:{uid}:{gid}::{home}:/bin/bash\n')
        (work / 'group').write_text(f'root:x:0:\n{user}:x:{gid}:\n')
        mounts = [f'{repo}:{repo}:ro', f'{site.parent}:{site.parent}:rw', f'{work}/passwd:/etc/passwd:ro',
                  f'{work}/group:/etc/group:ro']
        if (home / '.ssh').is_dir():
            mounts.append(f'{home / ".ssh"}:{home / ".ssh"}:ro')
        # HOME is a folder of the container, so no tool writes into the read-only checkout or the home folder. ssh
        # reads ~/.ssh of the passwd entry. HOOVER4_OPERATOR_BASE names this image, the base of the operator pod image.
        env = {IN_IMAGE: '1', 'HOOVER4_OPERATOR_BASE': image, 'HOOVER4_SITE': str(site), 'HOME': '/tmp/home', 'USER': user,
               'ANSIBLE_HOME': '/tmp/ansible', 'ANSIBLE_LOCAL_TEMP': '/tmp/ansible/tmp', 'XDG_CACHE_HOME': '/tmp/cache',
               'XDG_CONFIG_HOME': '/tmp/config', 'XDG_DATA_HOME': '/tmp/data', 'KUBECACHEDIR': '/tmp/kube-cache',
               'PYTHONDONTWRITEBYTECODE': '1'}
        agent = os.environ.get('SSH_AUTH_SOCK')
        if agent and Path(agent).exists():
            mounts.append(f'{agent}:{agent}')
            env['SSH_AUTH_SOCK'] = agent
        runtime = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{uid}'
        if Path(runtime).is_dir():
            # The podman service of the image builds.
            mounts.append(f'{runtime}:{runtime}')
            env['XDG_RUNTIME_DIR'] = runtime
            if Path(runtime, 'podman', 'podman.sock').exists():
                env['CONTAINER_HOST'] = f'unix://{runtime}/podman/podman.sock'
        args = [tool, 'run', '--rm', '--network', 'host', '--workdir', str(repo)]
        args += ['--userns=keep-id'] if tool == 'podman' else ['--user', f'{uid}:{gid}']
        if sys.stdin.isatty():
            args += ['-it']
        else:
            args += ['-i']
        for mount in mounts:
            args += ['-v', mount]
        for key, value in env.items():
            args += ['-e', f'{key}={value}']
        rest = [a for i, a in enumerate(argv) if a != '--site' and not a.startswith('--site=')
                and not (i > 0 and argv[i - 1] == '--site')]
        args += [image, 'python3', str(HERE / 'deploy-k3s'), *rest, '--site', str(site)]
        return subprocess.run(args).returncode
    finally:
        shutil.rmtree(work, ignore_errors=True)


def measure_speed(ctx, targets, deploy, records):
    """deploy-k3s measure-speed: the speed play under the site lock, and the new values in the cluster copy when the
    cluster answers. A node of the targets is usually stopped, so the cluster can be unavailable."""
    import json
    try:
        ctx.records.lock('measure-speed', 'measure-speed')
    except records.Busy as error:
        raise SystemExit(f'deploy-k3s: {error}')
    try:
        deploy.sync_state(ctx, 'pull')
        speeds = deploy.measure_speed(ctx, targets)
        deploy.sync_state(ctx, 'push')
    except deploy.StepFailed as error:
        raise SystemExit(f'deploy-k3s: {error}')
    finally:
        ctx.records.unlock()
    print(json.dumps({'speed': speeds}, indent=1))
    return 0


def main(argv):
    argv = bootstrap_checkout(argv)
    if os.environ.get(IN_IMAGE) != '1':
        return run_in_image(argv)
    Path(os.environ.get('HOME') or '/tmp/home').mkdir(parents=True, exist_ok=True)
    import argparse
    import json
    sys.path.insert(0, str(HERE))
    sys.path.insert(0, str(HERE / 'driver'))
    import config
    import deploy
    import records

    if argv and argv[0] == 'import-compose':
        # The import names the images of the commit of HEAD, as the steps of up do.
        try:
            env = dict(os.environ, HOOVER4_REVISION=deploy.resolve_revision(HERE.parent, 'HEAD'))
        except deploy.StepFailed as error:
            raise SystemExit(f'deploy-k3s: {error}')
        return subprocess.run([sys.executable, str(HERE / 'import_compose' / 'import_compose.py'), *argv[1:]],
                              env=env).returncode

    parser = argparse.ArgumentParser(prog='deploy-k3s', description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('command', choices=('render', 'check', 'up', 'down', 'status', 'measure-speed'))
    parser.add_argument('record', nargs='?')
    parser.add_argument('--site', default=os.environ.get('HOOVER4_SITE'), required=not os.environ.get('HOOVER4_SITE'))
    parser.add_argument('--target', nargs='+', default=[])
    parser.add_argument('--steps', nargs='+', default=[])
    parser.add_argument('--resume')
    parser.add_argument('--start', action='store_true')
    parser.add_argument('--manifests', action='store_true')
    parser.add_argument('--ask-become-pass', action='store_true')
    args = parser.parse_args(argv)

    try:
        site = config.read(args.site)
    except (config.SiteError, OSError) as error:
        raise SystemExit(f'deploy-k3s: the site file {args.site} has problems: {error}')
    ctx = deploy.Context(args.site, site)
    print(json.dumps({'site': site.id, 'site_file': str(ctx.site_path), 'state': str(ctx.private)}), flush=True)
    if args.ask_become_pass:
        ctx.ask_become_pass()

    if args.command == 'status':
        ids = [args.record] if args.record else ctx.records.list()
        for record_id in ids:
            r = ctx.records.load(record_id)
            print(json.dumps({k: r[k] for k in ('id', 'command', 'targets', 'revision', 'status', 'error')} |
                             {'steps': {s['name']: s['state'] for s in r['steps']}}, indent=1))
        applied = ctx.records.applied()
        print(json.dumps({'applied': applied and applied['id'], 'applied_revision': applied and applied['revision'],
                          'previous_revision': (ctx.records.previous() or {}).get('revision'),
                          'stopped': ctx.records.stopped()}, indent=1))
        return 0

    if args.resume:
        if args.command not in ('up', 'down'):
            raise SystemExit('--resume belongs to up and down.')
        record = ctx.records.load(args.resume)
        if record['command'] != args.command:
            raise SystemExit(f'the record {args.resume} belongs to {record["command"]}, not {args.command}.')
        targets = record['targets']
    else:
        targets = list(site.nodes) if args.target == ['all'] else args.target
        if not targets:
            raise SystemExit(f'deploy-k3s {args.command} needs --target with nodes of the site: {", ".join(site.nodes)}, or all.')
        unknown = [t for t in targets if t not in site.nodes]
        if unknown:
            raise SystemExit(f'deploy-k3s: {", ".join(unknown)} is not a node of the site. The nodes are: {", ".join(site.nodes)}.')

    try:
        revision = deploy.resolve_revision(ctx.repo, 'HEAD')
        if args.command in ('render', 'check'):
            # render and check read the cluster copy of the zone state and the operator state.
            deploy.sync_state(ctx, 'pull')
        if args.command == 'measure-speed':
            return measure_speed(ctx, targets, deploy, records)
        if args.command == 'render':
            print(json.dumps(deploy.render(ctx, targets, revision, args.manifests), indent=1, default=list))
            return 0
        if args.command == 'check':
            problems, state = deploy.check(ctx, targets)
            print(json.dumps({'problems': problems, 'state': state}, indent=1, default=list))
            return 1 if problems else 0
    except deploy.StepFailed as error:
        raise SystemExit(f'deploy-k3s: {error}')

    if args.resume and record['revision'] != revision:
        raise SystemExit(f'deploy-k3s: the record {record["id"]} belongs to {record["revision"][:12]}, and the checkout '
                         f'{ctx.repo} is at {revision[:12]}. Check out the commit of the record, or start a new run.')
    try:
        ctx.records.lock(args.command, f'{args.command}-{args.resume or revision[:12]}')
    except records.Busy as error:
        raise SystemExit(f'deploy-k3s: {error}')
    try:
        ctx.revision = revision
        # The plan names the zones of the zone state, so the state folder first gets the cluster copy.
        deploy.sync_state(ctx, 'pull')
        if args.resume:
            ctx.kubelet_hold = record.get('kubelet_hold') or {}
            steps = deploy.plan(ctx, record['command'], targets, start=record.get('start', False))
            names = [s['name'] for s in record['steps']]
            missing = [n for n in names if n not in steps]
            if missing:
                raise SystemExit(f'deploy-k3s: the plan of this checkout has no step {", ".join(missing)}. '
                                 f'Start a new {record["command"]}.')
        else:
            # A kubelet reserve that would refuse running pods waits for the steps that lower the requests
            # (../kubelet.py).
            ctx.kubelet_hold = deploy.kubelet_hold(ctx, targets) if args.command == 'up' and not args.start else {}
            steps = deploy.select(deploy.plan(ctx, args.command, targets, start=args.start), args.steps)
            if 'hosts:k3s' not in steps:
                ctx.kubelet_hold = {}
                steps.pop('hosts:kubelet', None)
            complete = not args.steps and not args.start and set(targets) == set(site.nodes)
            record = ctx.records.new(args.command, targets, revision, list(steps), start=args.start, complete=complete,
                                     kubelet_hold=ctx.kubelet_hold,
                                     checkout=str(ctx.repo), checkout_changes=deploy.dirty_files(ctx.repo),
                                     applied_before=(ctx.records.applied() or {}).get('revision'),
                                     inputs=deploy.pinned_inputs(ctx))
            print(json.dumps({'record': record['id'], 'revision': revision, 'steps': list(steps)}), flush=True)
        return deploy.execute(ctx, record, steps)
    except deploy.StepFailed as error:
        raise SystemExit(f'deploy-k3s: {error}')
    finally:
        ctx.records.unlock()


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
