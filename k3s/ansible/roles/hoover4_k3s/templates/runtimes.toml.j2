# containerd collects the CPU statistics of every container and sandbox at this period. For each gVisor container one
# collection starts one runsc command (about 7 ms of CPU). The default period of 1 s cost about 0.3 threads on a node
# with 40 gVisor pods. 10 s is the housekeeping period of the kubelet.
[plugins.'io.containerd.cri.v1.runtime']
  stats_collect_period = "10s"
# gVisor for the openDesk and Hoover web applications.
[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runsc]
  runtime_type = "io.containerd.runsc.v1"
  runtime_path = "/opt/gvisor/containerd-shim-runsc-v1"
[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runsc.options]
  TypeUrl = "io.containerd.runsc.v1.options"
  ConfigPath = "/etc/gvisor/runsc.toml"
{% if hoover4_gpu | bool %}
# runsc with nvproxy for the GPU services. The binary is the staged build of gVisor PR 16643 when it exists.
[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runsc-nvproxy]
  runtime_type = "io.containerd.runsc.v1"
  runtime_path = "/opt/gvisor/containerd-shim-runsc-v1"
[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runsc-nvproxy.options]
  TypeUrl = "io.containerd.runsc.v1.options"
  ConfigPath = "/etc/gvisor/runsc-nvproxy.toml"
{% elif hoover4_kata | bool %}
# Kata Containers with the Go runtime and Cloud Hypervisor for the stores and parse workers.
[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.kata]
  runtime_type = "io.containerd.kata.v2"
  runtime_path = "/opt/kata/bin/containerd-shim-kata-v2"
[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.kata.options]
  ConfigPath = "/etc/kata-containers/configuration-clh.toml"
  SystemdCgroup = true
{% endif %}
