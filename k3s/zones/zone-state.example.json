{
 "schemaVersion": 1,
 "zones": {
  "zone-a": {
   "enabled": true,
   "home": "public-node",
   "namespaces": [
    "zone-a",
    "hoover-zone-a"
   ],
   "bootstrapped": true
  },
  "zone-b": {
   "enabled": true,
   "home": "server-node",
   "namespaces": [
    "zone-b",
    "hoover-zone-b"
   ],
   "bootstrapped": true,
   "stores": "zone",
   "temporal_backend": "postgresql",
   "extra_datasets": ["archive:server-node:/storage/archive"],
   "tiers": {
    "default": ["hdd"]
   }
  }
 }
}
