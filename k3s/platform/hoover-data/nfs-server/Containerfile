# The NFS server of the Hoover data directories (../install-hoover-data.py). It runs the kernel NFS server in the
# network namespace of its pod. kmod loads the nfsd module of the node, and curl with jq reads the zone namespaces.
FROM docker.io/library/alpine:3.22
RUN apk add --no-cache nfs-utils kmod curl jq
COPY run.sh /run.sh
ENTRYPOINT ["/bin/sh", "/run.sh"]
