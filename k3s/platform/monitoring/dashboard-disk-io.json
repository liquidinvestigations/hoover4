{
 "uid": "disk-io",
 "title": "Disk I/O",
 "tags": [
  "lab"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Write operations per device",
   "description": "Each block device of the node. A TopoLVM volume is a dm device.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "wps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(node_disk_writes_completed_total{device=~\"sda|nvme0n1|dm-0\"}[1m])",
     "legendFormat": "{{device}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Write latency per device",
   "description": "Average time of one write.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(node_disk_write_time_seconds_total{device=~\"sda|nvme0n1|dm-0\"}[1m]) / clamp_min(rate(node_disk_writes_completed_total{device=~\"sda|nvme0n1|dm-0\"}[1m]),1)",
     "legendFormat": "{{device}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Busy time per device",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(node_disk_io_time_seconds_total{device=~\"sda|nvme0n1|dm-0\"}[1m])",
     "legendFormat": "{{device}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Bytes written per device",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(node_disk_written_bytes_total{device=~\"sda|nvme0n1|dm-0\"}[1m])",
     "legendFormat": "{{device}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "I/O pressure on the host",
   "description": "Share of time in which tasks wait for I/O.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(node_pressure_io_stalled_seconds_total[1m])",
     "legendFormat": "all tasks stalled"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(node_pressure_io_waiting_seconds_total[1m])",
     "legendFormat": "some tasks waiting"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Write operations per pod, top 10",
   "description": "A Kata pod includes the writes of its VM.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "wps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "topk(10, sum by (namespace, pod) (rate(container_fs_writes_total{container=\"\", pod!=\"\"}[2m])))",
     "legendFormat": "{{namespace}}/{{pod}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Bytes written per pod, top 10",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "topk(10, sum by (namespace, pod) (rate(container_fs_writes_bytes_total{container=\"\", pod!=\"\"}[2m])))",
     "legendFormat": "{{namespace}}/{{pod}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Write operations per pod and device, top 10",
   "description": "Each TopoLVM volume is a dm device of its volume group.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "wps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "topk(10, sum by (namespace, pod, device) (rate(container_fs_writes_total{container=\"\", pod!=\"\"}[2m])))",
     "legendFormat": "{{namespace}}/{{pod}} {{device}}"
    }
   ]
  }
 ]
}