# Copy this file to TEST_LOGIN.env beside take-screenshots.sh.
# Agents read these values for a browser work package.
# take-screenshots.sh and observe-chat.sh load this file when it exists,
# unless HOOVER4_TEST_USERNAME and HOOVER4_TEST_PASSWORD are already set.
# Do not pass credential values as wrapper arguments.
HOOVER4_TEST_LOGIN_URL=
HOOVER4_SITE_URL=
HOOVER4_TEST_USERNAME=
HOOVER4_TEST_PASSWORD=
