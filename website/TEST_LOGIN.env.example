# Copy this file to TEST_LOGIN.env beside take-screenshots.sh.
# Agents read these values for a browser work package.
# take-screenshots.sh, observe-chat.sh and run-manual-qa.sh load this file when it exists,
# unless HOOVER4_TEST_USERNAME and HOOVER4_TEST_PASSWORD are already set.
# There is no built-in site URL. Set HOOVER4_SITE_URL here or in the environment,
# or pass --target. The real site URL is copied from the gitignored inventory
# file at the repository root. Do not put a real hostname in this example.
# Do not pass credential values as wrapper arguments.
HOOVER4_TEST_LOGIN_URL=
# HOOVER4_SITE_URL=https://example.invalid
HOOVER4_SITE_URL=
HOOVER4_TEST_USERNAME=
HOOVER4_TEST_PASSWORD=
