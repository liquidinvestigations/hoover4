processing-updates-unit =
    { $unit ->
        [folders]
            { $count ->
                [one] mappe
               *[other] mapper
            }
        [tables]
            { $count ->
                [one] tabel
               *[other] tabeller
            }
       *[files]
            { $count ->
                [one] fil
               *[other] filer
            }
    }
