processing-update-unfinished-title = معالجة غير مكتملة
processing-update-unfinished-explanation = { $files ->
    [one] ملف واحد لم تكتمل معالجته.
    [two] ملفان لم تكتمل معالجتهما.
    [few] { $count } ملفات لم تكتمل معالجتها.
   *[other] { $count } ملفًا لم تكتمل معالجتها.
} يشمل ذلك الملفات بلا خطة معالجة، مثلًا بعد استيعاب انقطع. تكتمل معالجتها.
processing-update-unfinished-runs = كل مراحل المعالجة لهذه الملفات
processing-update-failed_files-title = الملفات الفاشلة
processing-update-failed_files-explanation = { $files ->
    [one] ملف واحد فيه خطأ معالجة.
    [two] ملفان فيهما خطأ معالجة.
    [few] { $count } ملفات فيها خطأ معالجة.
   *[other] { $count } ملفًا فيها خطأ معالجة.
} تُشغَّل المراحل الفاشلة لها مرة أخرى. يعيد التشغيل التلقائي محاولة الملف مرة واحدة لكل إصدار جديد من المرحلة التي فشلت.
processing-update-failed_files-runs = المراحل الفاشلة، ثم استخراج الكيانات والتضمين والفهرسة
processing-update-virus_scan-title = فحص الفيروسات
processing-update-virus_scan-explanation = { $files ->
    [one] ملف واحد بلا حكم من مضاد الفيروسات.
    [two] ملفان بلا حكم من مضاد الفيروسات.
    [few] { $count } ملفات بلا حكم من مضاد الفيروسات.
   *[other] { $count } ملفًا بلا حكم من مضاد الفيروسات.
} تُفحص هذه الملفات. الملف الذي يجده الماسح مصابًا يُعلَّم في البحث، ويُرفض تنزيل أصله وملف PDF القابل للبحث الخاص به.
processing-update-virus_scan-runs = فحص مضاد الفيروسات، ثم سمة البحث للملفات المصابة
processing-update-tables-title = الجداول
processing-update-tables-explanation = { $files ->
    [one] ملف واحد هو ملف JSON أو JSON Lines بلا جدول من القارئ الحالي، أو بجدول قصّه قارئ سابق عند 300 عمود.
    [two] ملفان هما ملفا JSON أو JSON Lines بلا جدول من القارئ الحالي، أو بجدولين قصّهما قارئ سابق عند 300 عمود.
    [few] { $count } ملفات هي ملفات JSON أو JSON Lines بلا جدول من القارئ الحالي، أو بجداول قصّها قارئ سابق عند 300 عمود.
   *[other] { $count } ملفًا هي ملفات JSON أو JSON Lines بلا جدول من القارئ الحالي، أو بجداول قصّها قارئ سابق عند 300 عمود.
} تُقرأ من جديد. تحصل ملفات JSON التي قرأها قارئ سابق على أنها CSV على جدول JSON الخاص بها، وتتوقف خلاياها السابقة عن الظهور. يحفظ القارئ الحالي قيمة null في JSON كخلية فارغة، وJSON المتداخل كنص بمسافات بادئة.
processing-update-tables-runs = قراءة الجداول، ثم نوع الملف وفهرسة هذه الملفات
processing-update-ocr-title = OCR
processing-update-ocr-explanation = { $files ->
    [one] نحو ملف واحد بلا نص OCR للغات الحالية، أو يحتفظ بنص OCR للغات لم تعد في الإعدادات.
    [two] نحو ملفين بلا نص OCR للغات الحالية، أو يحتفظان بنص OCR للغات لم تعد في الإعدادات.
    [few] نحو { $count } ملفات بلا نص OCR للغات الحالية، أو تحتفظ بنص OCR للغات لم تعد في الإعدادات.
   *[other] نحو { $count } ملفًا بلا نص OCR للغات الحالية، أو تحتفظ بنص OCR للغات لم تعد في الإعدادات.
} يُشغَّل OCR للغات الحالية، ويُحذف نص اللغات المُزالة.
processing-update-ocr-runs = OCR وملفات PDF القابلة للبحث، ثم استخراج الكيانات والتضمين والفهرسة للنص الجديد
processing-update-vectors-title = المتجهات
processing-update-vectors-explanation = { $files ->
    [one] ملف واحد فيه نص بلا متجهات لنموذج التضمين الذي يخدمه التثبيت.
    [two] ملفان فيهما نص بلا متجهات لنموذج التضمين الذي يخدمه التثبيت.
    [few] { $count } ملفات فيها نص بلا متجهات لنموذج التضمين الذي يخدمه التثبيت.
   *[other] { $count } ملفًا فيها نص بلا متجهات لنموذج التضمين الذي يخدمه التثبيت.
} تُحسب المتجهات وتُفهرس.
processing-update-vectors-runs = التضمين وفهرسة المتجهات
processing-update-folder_counts-title = أعداد المجلدات
processing-update-folder_counts-explanation = { $files ->
    [one] مجلد واحد بلا عدد ملفات أو حجم، أو بقيم من إصدار سابق.
    [two] مجلدان بلا عدد ملفات أو حجم، أو بقيم من إصدار سابق.
    [few] { $count } مجلدات بلا عدد ملفات أو حجم، أو بقيم من إصدار سابق.
   *[other] { $count } مجلدًا بلا عدد ملفات أو حجم، أو بقيم من إصدار سابق.
} تُحسب الأعداد من جديد.
processing-update-folder_counts-runs = شجرة المجلدات
