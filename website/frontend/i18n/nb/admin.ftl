processing-updates-unit =
    { $unit ->
        [folders]
            { $count ->
                [one] mappe
               *[other] mapper
            }
        [tables]
            { $count ->
                [one] tabell
               *[other] tabeller
            }
       *[files]
            { $count ->
                [one] fil
               *[other] filer
            }
    }
