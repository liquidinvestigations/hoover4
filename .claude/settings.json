{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "The settings this repository expects at .claude/settings.json. `.claude` is a protected path in Claude Code, so a write there is never auto-approved and no allow rule pre-approves it. Edit this template, then run `.agents/update-configs.sh` to copy it over and restart the session. `.agents/verify-wiring.sh` reports whether the two files agree. Narrow Bash allow rules resolve before the auto mode classifier; a blanket `Bash(*)` is dropped in auto mode and only works in manual mode, so both are listed.",
  "permissions": {
    "allow": [
      "mcp__hoover4-browser",
      "mcp__hoover4-web-search",
      "mcp__hoover4-whois",
      "mcp__serena",
      "Bash(docker exec *)",
      "Bash(./.agents/*)",
      "Bash(./deploy *)",
      "Bash(./main_services/*)",
      "Bash(./website/*)",
      "Bash(python3 .agents/check-prose-style.py *)",
      "Bash(python3 .agents/check-doc-ids.py *)",
      "Bash(python3 .agents/check-workflow-diff.py *)",
      "Bash(*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.agents/hooks/deny-unscoped-search.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.agents/hooks/deny-long-commit-message.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.agents/hooks/deny-claudisms.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.agents/hooks/warn-tool-call-budget.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.agents/hooks/session-start-orientation.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
