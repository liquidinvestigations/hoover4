# This file is the development sample. Copy it to hoover4.ini only on a host that other people cannot reach.
# Run `./deploy --check` after each change. docs/operations/Configuration_Reference.md describes each key.

[storage]
# This required absolute host folder holds one folder for each volume.
volumes_path =
# Garage declares this size for its store and reports the store full above it.
garage_capacity = 300G

# The worker and the website mount host_path at container_path.
[dataset_mount.testdata]
host_path = /opt/hoover4-testdata
container_path = /testdata
writable = false

[ai_services]
# This switch controls the GPU tier on both hosts. False starts no GPU service and clears the GPU addresses.
enabled = false
# The main-host containers reach the GPU host at this address.
host = 127.0.0.1
# The GPU services bind to this interface. Use the private-network address.
bind_ip = 0.0.0.0

# ---- language model: Qwen Flash ----

# True starts the model server. The research agents start only when this is true.
llm_enabled = false
vllm_port = 21960
# This host path names a chmod-600 file outside the repository with the API key of the model server.
vllm_api_key_file =

# ---- NER, embeddings and reranking ----

ai_server_enabled = true
ai_server_port = 21961
ner_enabled = true
embeddings_enabled = true
reranker_enabled = true
# Each value limits the requests in progress for one model. Above it and the queue, the server returns 503.
ai_server_ner_concurrency = 4
ai_server_embed_concurrency = 8
ai_server_rerank_concurrency = 4

# ---- GPU OCR ----

easyocr_enabled = true
easyocr_port = 21962

[main_services]
# ---- OCR ----

# This key selects the OCR engines of searchable PDFs: easyocr, tesseract, both or none.
pdf_ocr_provider = tesseract
tesseract_cpu_enabled = true
ocr_pdf_enabled = true

# ---- memory limits of the datastores ----

# This value is required. Each Manticore start replays its binlog inside this limit.
manticore_mem_limit = 32G
manticore_vectors_mem_limit = 32G
# The ClickHouse server uses at most clickhouse_server_memory_ratio of this limit.
clickhouse_mem_limit = 19000M
clickhouse_server_memory_ratio = 0.7
clickhouse_ui_mem_limit = 6000M
clickhouse_monitoring_mem_limit = 6000M
# Empty is the larger of 8000M and 2048M plus 512M for each ocr_pdf_concurrency slot.
ocr_pdf_mem_limit =

# ---- regex entity scanning ----

# One thread scans about 0.85 MB/s.
regex_scanner_threads = 10
# Above this queue depth, the scanner returns 503.
regex_scanner_queue_depth = 32
# The value must be at least 4G.
regex_scanner_mem_limit = 4G

# ---- the website ----

# True serves a release build. False runs `dx serve`, which is for development only.
website_release_mode = false

# ---- search limits ----

# This value limits the Manticore queries in progress across the website. Empty is 8.
search_max_parallelism =
# A shard query that runs longer than this many seconds fails the request. Empty is 30.
search_timeout_seconds =
# One shard query expands at most this many wildcard terms. Zero removes the limit.
manticore_expansion_limit = 5000

# ---- worker fleet: an empty value keeps the measured default of the tier ----

# This value sets the common-worker processes. Empty is 10.
common_workers =
# Each common worker has this many activity slots. Empty is 3.
common_concurrency =
# Each common worker keeps this many workflow runs in memory.
common_max_cached_workflows = 100
# This value limits the memory of the worker container.
worker_mem_limit = 29000M
# Empty uses tika_parse_processes.
tika_concurrency =
tika_mem_limit = 6G
tika_parse_processes = 4
tika_parse_heap = 1g
# This value sets the image OCR slots. Empty is 4.
ocr_concurrency =
# Empty uses tesseract_cpu_concurrency.
ocr_pdf_concurrency =
# Empty uses ocr_pdf_concurrency.
ocr_pdf_queue_depth =
ocr_pdf_files_per_batch = 4
pdf_preview_concurrency = 2
# Empty is 4.
nlp_concurrency =
# Empty is 6.
embed_concurrency =
# Empty is 1.
indexing_concurrency =
# This value sets the index-worker processes. Empty is 4.
indexing_workers = 8
# This value limits the model calls of chat turns in progress. Empty is 3.
chat_model_concurrency = 3
# This value limits the chat writes, todo reads and session titles in progress. Empty is 8.
chat_low_latency_concurrency = 4
# This value limits the tool calls of all agent runs in progress. Empty is 16.
agent_tool_concurrency = 16
# This value limits the chat polls that one user holds at once. Above it, a poll returns at once.
max_held_polls_per_user = 8
# This value limits the chat polls that one user sends in one minute.
rate_chat_poll_per_minute = 1800

# ---- internet tools ----

# True starts the browser, metasearch and whois MCP servers.
internet_tools_enabled = false
# The browser MCP server runs at most this many Chromium processes, one for each chat.
browser_max_contexts = 16
browser_reader_tabs = 4
browser_search_tabs = 2
browser_queue_limit = 32
browser_read_timeout_seconds = 180
browser_fetch_token_file =
web_search_concurrency = 4
web_search_queue_limit = 16
web_search_queue_wait_seconds = 60
web_search_fetch_budget_seconds = 60
# This switch starts private Tor clients for web reads when internet_tools_enabled is true.
web_tor_enabled = true
web_tor_mem_limit = 512M
mcp_browser_mem_limit = 24G
# This host path names a chmod-600 file with the fact-check API key. Empty removes that source.
factcheck_api_key_file =

# ---- agent runs ----

# This value is a comma list of catalogue, collections, conversation, web and browser, or all.
agent_packs_chat = all
# One catalogue search returns this many matches, from 6 to 12. Empty is 6.
agent_catalogue_match_count =
# A model step or a tool call waits at most this many seconds for a slot. Empty sets no limit.
agent_queue_wait_seconds = 5400
# This value is the read timeout of a title request in seconds. Empty is 30.
title_request_timeout_seconds = 120
# This value is the read timeout of one board assessment request in seconds. Empty is 600.
board_reason_request_seconds = 600
# This value limits one model call in seconds. When it is set, the model client does not retry.
llm_request_timeout_seconds = 3600
# This value limits the output tokens of one agent model request. Empty sends no limit.
agent_max_output_tokens = 32768
# This switch streams the tokens of agent model calls. Empty is true.
llm_streaming =
# hoover4-full-research-agent runs this many uvicorn processes.
full_research_agent_workers = 4
# Compaction starts at this fraction of the context window of the model.
agent_compaction_fraction = 0.80
# This absolute host folder holds custom chat policy handlers. Empty uses the built-in handlers.
chat_control_dir =
# This host path names a chmod-600 file with the token between the agents and the MCP servers.
mcp_shared_secret_file =

# ---- GPU host failures ----

# A short connect timeout stops a failed GPU host from blocking the pipeline.
gpu_connect_timeout_ms = 2000
# After consecutive failures, requests skip that endpoint for this many seconds.
gpu_circuit_break_seconds = 60

# ---- worker shutdown ----

# In-progress activities get this many seconds at shutdown. The container waits 30 s more.
worker_graceful_shutdown_seconds = 60

# ---- the operations container ----

ops_mem_limit = 4000M
ops_cpus = 4
# This host folder holds backups. Empty uses <volumes_path>/ops_backups.
ops_backup_dir =
# A ClickHouse backup reads at most this many bytes per second. 0 sets no limit.
ops_backup_bandwidth_bytes = 0
# One backup object volume holds this many bytes. Empty is 8 GiB, and the minimum is 1048576.
ops_backup_object_volume_bytes =
# A detached CLI prints this admin address. Empty prints the operation id only.
admin_base_url =
# The operations page marks a task type when its failure rate is above this percent.
error_rate_alert_percent = 5

# ---- development tools ----

# True starts a container that signs in every request as proxy_username. Use it only for development.
development_auth_backdoor_enabled = true
proxy_username = admin
# Write a comma list without spaces. The group admin or superuser makes the user an administrator.
proxy_groups = admin

# ---- bind addresses ----

# The website accepts X-Forwarded-User from any caller. Only the identity proxy may reach it.
website_bind_ip = 127.0.0.1
# The infrastructure ports have no authentication. Keep 127.0.0.1 and use an ssh tunnel.
infra_bind_ip = 127.0.0.1

# ---- ports: the website always uses 12345 ----

clickhouse_http_port = 21900
clickhouse_native_port = 21901
manticore_sql_port = 21902
manticore_http_port = 21903
manticore_vectors_sql_port = 21914
manticore_vectors_http_port = 21915
garage_s3_port = 21904
# This port binds to 127.0.0.1 only.
garage_admin_port = 21905
redis_port = 21906
temporal_grpc_port = 21907
temporal_http_port = 21908
temporal_ui_port = 21909
clickhouse_monitoring_port = 21910
ch_ui_port = 21911
cassandra_port = 21912
elasticsearch_port = 21913
pdf_to_html_port = 21920
tesseract_cpu_port = 21921
ocr_pdf_port = 21922
regex_entity_scanner_port = 21925
mcp_collections_port = 21930
mcp_metasearch_port = 21941
mcp_browser_port = 21942
mcp_whois_port = 21934
mcp_todo_port = 21935
internal_search_agent_port = 21936
full_research_agent_port = 21937

# ---- Temporal history ----

# This value is fixed after the first start. A change needs `./deploy --reset-temporal`.
temporal_history_shards = 128

# ---- Temporal and its Cassandra ----

# The value must be at least cassandra_heap plus cassandra_direct_memory plus 3G.
cassandra_mem_limit = 16000M
cassandra_cpus = 8
cassandra_heap = 8G
# Empty is 100M for each CPU of cassandra_cpus.
cassandra_heap_new =
cassandra_direct_memory = 2G
# Empty keeps 4.
cassandra_malloc_arenas =
cassandra_chunk_cache_mb = 512
temporal_mem_limit = 8000M
temporal_ui_mem_limit = 6000M
temporal_cpus = 8
# Temporal keeps a closed workflow for this time.
temporal_retention = 168h
# Each value limits persistence queries per second. Empty keeps the Temporal default.
temporal_history_persistence_qps =
temporal_frontend_persistence_qps =
temporal_matching_persistence_qps =

# ---- Tesseract CPU OCR ----

# This value limits the OCR requests in progress. The queue holds 4 times this value.
tesseract_cpu_concurrency = 2
# This value sets OMP_THREAD_LIMIT. Empty leaves it unset.
tesseract_threads_per_page =
# This value is the CPU limit. Empty sets no limit.
tesseract_cpu_cpus =
# Empty is 4096M plus 1024M for each tesseract_cpu_concurrency slot.
tesseract_cpu_mem_limit =

# ---- ClamAV ----

# False records each file as not scanned and starts no scanner.
clamav_enabled = true
clamav_update_signatures = true
clamav_concurrency = 4
clamav_mem_limit = 4G

# ---- container logs ----

container_log_max_size = 100m
container_log_max_files = 5

[operations]
# Each cap limits the running operations of one kind. Other operations of that kind wait as queued.
add_dataset_cap = 2
rescan_dataset_cap = 2
compute_plans_cap = 2
execute_plans_cap = 2
purge_dataset_cap = 2
delete_dataset_cap = 2
rerun_ocr_cap = 2
reindex_collection_cap = 2
refresh_document_locations_cap = 2
retry_failed_files_cap = 2
ensure_collection_cap = 2
drop_collection_database_cap = 2
export_collection_cap = 2
import_collection_cap = 2
purge_unattributed_entities_cap = 2
backfill_vectors_cap = 2
ingest_upload_cap = 2
update_dataset_cap = 2
update_collection_cap = 2

[processing_updates]
# True starts processing updates after a deployment, a settings change or new input.
automatic = true

[uploads]
max_batch_files = 10000
max_batch_bytes = 10737418240
max_file_bytes = 10737418240
# This value limits the bytes of one PATCH request. Keep it below the body limit of each proxy.
chunk_bytes = 786432
# A batch without a transfer for this many hours is committed with the files it has.
abandon_hours = 24
