Vérifiez les valeurs des filtres avec {{ tool('search_facet_values') }}.
{% endif %}
{% if has('search_histogram') %}
Vérifiez les dates avec {{ tool('search_histogram') }}.
{% endif %}
{% if has('search_passages') %}
4. Recherchez une description du contenu avec {{ tool('search_passages') }}.
{% endif %}
{% if has('folder_search') %}
5. Utilisez {{ tool('folder_search') }} quand la demande nomme un dossier, un chemin ou un fichier.
{% endif %}
