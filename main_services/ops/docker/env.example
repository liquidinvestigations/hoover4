COMPOSE_PROJECT_NAME=hoover4
CASSANDRA_VERSION=3.11.9
ELASTICSEARCH_VERSION=7.17.27
TEMPORAL_VERSION=1.23.1
TEMPORAL_UI_VERSION=2.26.2
MINIO_VERSION=RELEASE.2025-07-23T15-54-02Z
TZ=UTC
NER_URL=http://10.69.70.102:8821/v1
EXTERNAL_CLICKHOUSE_URL=http://10.69.70.112:8123
# Demo mode: treat anonymous guest-* sessions as admins (guest gets full admin UI).
# Set to true only for public demo deployments.
HOOVER4_DEMO_MODE=true
# Host dir mounted at /testdata in the worker (must exist on the host).
# Defaults to the in-repo ../../../testdata; point at a larger dataset if needed.
# HOOVER4_TESTDATA_DIR=/opt/hoover4-testdata
# Max concurrent Manticore queries during website search fan-out (default 8).
# HOOVER4_SEARCH_MAX_PARALLELISM=8