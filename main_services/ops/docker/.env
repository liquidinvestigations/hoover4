COMPOSE_PROJECT_NAME=hoover4
CASSANDRA_VERSION=3.11.9
ELASTICSEARCH_VERSION=7.17.27
TEMPORAL_VERSION=1.23.1
TEMPORAL_UI_VERSION=2.26.2
MINIO_VERSION=RELEASE.2025-07-23T15-54-02Z
TZ=UTC
# GPU NER service for the P4 entity-extraction stage. Now the local
# `hoover4-ai-server` from ai_services/docker-compose.yaml, reached over the shared
# `hoover4` network — the old 10.69.70.102 address was behind a VPN that no longer
# exists, which is why every P4 activity was failing.
#
# If the AI tier is not running, override locally in your shell rather than committing
# a change here (export NER_URL=... before docker compose up; the shell value wins).
# With a dead address P4 fails fast, records processing_errors and continues with empty
# entity MVAs.
NER_URL=http://hoover4-ai-server:8000/v1
EXTERNAL_CLICKHOUSE_URL=http://127.0.0.1:8123
# EXTERNAL_CLICKHOUSE_URL=http://10.69.70.112:8123
# Demo mode: treat anonymous guest-* sessions as admins.
HOOVER4_DEMO_MODE=true
# Host dir mounted at /testdata in the worker (must exist). Defaults to ../../../testdata.
# HOOVER4_TESTDATA_DIR=/opt/hoover4-testdata
