# Hoover4 AI services configuration — single-host deployment.
#
#   cp env.example .env
#
# Every value below has a working default in docker-compose.yaml, so an unedited copy
# brings the stack up. The one you should change before anything but a local prototype
# is MCP_SHARED_SECRET.

# ---------------------------------------------------------------- shared / security
# Bearer token the agents present to the MCP servers. When empty the MCP servers accept
# any caller and log a warning; the ports are bound to 127.0.0.1, so that is survivable
# locally and unacceptable anywhere else.
MCP_SHARED_SECRET=

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ---------------------------------------------------------------- main-stack backends
# Reached over the shared `hoover4` podman network, so these are service names, not IPs.
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=hoover4
CLICKHOUSE_PASSWORD=hoover4
MANTICORE_URL=http://manticore:9308

# ---------------------------------------------------------------- embeddings/NER/rerank
AI_SERVER_PORT=8821
AI_SERVER_OPTIMAL_BATCH_SIZE=32
AI_SERVER_MAX_SEQUENCE_LENGTH=512
AI_SERVER_ENABLE_HALF_PRECISION=true
# Off by default: several minutes of startup cost for a modest gain.
AI_SERVER_ENABLE_TORCH_COMPILE=false
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
EMBEDDING_DIM=1024
# HUGGING_FACE_HUB_TOKEN=

# ---------------------------------------------------------------- local LLM (vLLM)
VLLM_PORT=8011
LLM_MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
LLM_SERVED_NAME=qwen3-4b
# Fraction of the 24 GB card vLLM may claim. The embedding server needs the rest;
# lower this first if either service OOMs.
VLLM_GPU_FRACTION=0.45
VLLM_MAX_MODEL_LEN=16384

# The agent talks the OpenAI API directly (langchain ChatOpenAI), NOT through LiteLLM,
# so this is the plain served model name with no provider prefix. `openai/qwen3-4b`
# gives a 404 from vLLM.
LLM_MODEL=qwen3-4b
LLM_BASE_URL=http://hoover4-vllm:8000/v1
LLM_API_KEY=hoover4-local-key
LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------- collection search MCP
COLLECTION_MCP_PORT=8085
SEARCH_MAX_RESULTS=8
SEARCH_SNIPPET_CHARS=1200

# ---------------------------------------------------------------- open-web MCP servers
DDG_SERVER_PORT=8889
DDG_SERVER_NAME=ddgs
DDG_DEFAULT_REGION=wt-wt
DDG_DEFAULT_MAX_RESULTS=3
DDG_DEFAULT_SAFESEARCH=off
DDG_DEFAULT_TIMELIMIT=
DDG_PROXY_URL=
DDG_TIMEOUT=30

WIKIPEDIA_SERVER_PORT=8093
WIKIPEDIA_LANGUAGE=en
WIKIPEDIA_MAX_RESULTS=3

WHOIS_SERVER_PORT=8092
WHOIS_RATE_LIMITING=true
WHOIS_RATE_LIMIT_MS=100

# ---------------------------------------------------------------- agents
INTERNAL_SEARCH_AGENT_PORT=9099
FULL_RESEARCH_AGENT_PORT=9090

# ---------------------------------------------------------------- tracing (optional)
# Leave empty to run without Langfuse. The /feedback endpoints return 503 when unset;
# chat works either way.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
