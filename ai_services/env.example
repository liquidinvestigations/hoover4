# Hoover4 AI services configuration — single-host deployment.
#
#   cp env.example .env
#
# Every value below has a working default in docker-compose.yaml, so an unedited copy
# brings the stack up. The one you should change before anything but a local prototype
# is MCP_SHARED_SECRET.

# ---------------------------------------------------------------- shared / security
# Bearer token the agents present to the MCP servers. When empty the MCP servers accept
# any caller and log a warning; the ports are bound to 127.0.0.1, so that is survivable
# locally and unacceptable anywhere else.
MCP_SHARED_SECRET=

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ---------------------------------------------------------------- main-stack backends
# Reached over the shared `hoover4` podman network, so these are service names, not IPs.
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=hoover4
CLICKHOUSE_PASSWORD=hoover4
MANTICORE_URL=http://manticore:9308

# ---------------------------------------------------------------- embeddings/NER/rerank
AI_SERVER_PORT=8821
AI_SERVER_OPTIMAL_BATCH_SIZE=32
AI_SERVER_MAX_SEQUENCE_LENGTH=512
AI_SERVER_ENABLE_HALF_PRECISION=true
# Off by default: several minutes of startup cost for a modest gain.
AI_SERVER_ENABLE_TORCH_COMPILE=false
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
EMBEDDING_DIM=1024
# HUGGING_FACE_HUB_TOKEN=

# ---------------------------------------------------------------- local LLM (vLLM)
VLLM_PORT=8011
# vLLM 0.17 is the first release with native Qwen3.5 (`qwen3_5`) support.
VLLM_IMAGE=vllm/vllm-openai:v0.17.1
LLM_MODEL_NAME=Qwen/Qwen3.5-2B
LLM_SERVED_NAME=qwen3.5-2b

# Fraction of the 24 GB card vLLM may claim. The embedding server needs ~2.9 GB and the
# desktop session ~1.7 GB; lower this first if either service OOMs.
#
# 0.50 holds the model at its FULL 262,144-token native context. That is only possible
# because 18 of Qwen3.5-2B's 24 layers are Gated-DeltaNet with a constant recurrent
# state, leaving 6 attention layers with a growing KV cache at 12 KiB/token — so 262 K
# tokens cost 3 GiB, not the ~36 GiB the same context cost on the Qwen3-4B this
# replaces. Check the real numbers after any change:
#   docker logs hoover4-vllm 2>&1 | grep -E "GPU KV cache size|Maximum concurrency"
#
# Read `Maximum concurrency`, NOT `GPU KV cache size`. On this model vLLM reports
#   Available KV cache memory: 5.95 GiB
#   GPU KV cache size: 129,472 tokens          <- LOOKS like half of max_model_len
#   Maximum concurrency for 262,144 tokens per request: 1.97x
# The token figure is normalised over all 24 layers, but only 6 of them keep a KV cache,
# so the real capacity is 4x it — 517,888 tokens, i.e. 1.97 full-length sequences, and
# 5.95 GiB / 517,888 = 12.05 KiB/token exactly as the arithmetic above predicts.
# Verified end to end: a 200,021-token prompt is accepted and answered.
VLLM_GPU_FRACTION=0.50
VLLM_MAX_MODEL_LEN=262144
# Tool-call parser. `hermes` was right for Qwen3-4B and is WRONG here: Qwen3.5 emits
# XML-style `<tool_call><function=name>` blocks, which hermes does not match, so every
# tool call arrives as plain text and the agent silently makes zero of them.
# The registered name has an underscore (`qwen3_xml`), unlike its source filename.
VLLM_TOOL_PARSER=qwen3_xml

# The agent talks the OpenAI API directly (langchain ChatOpenAI), NOT through LiteLLM,
# so this is the plain served model name with no provider prefix. It must equal
# LLM_SERVED_NAME above. `openai/qwen3.5-2b` gives a 404 from vLLM.
LLM_MODEL=qwen3.5-2b
LLM_BASE_URL=http://hoover4-vllm:8000/v1
LLM_API_KEY=hoover4-local-key
LLM_TEMPERATURE=0.0
# Token streaming. See the compose comment and README: the Q12 tool-call bug that forced
# this off is fixed on vLLM 0.17.1, verified with a real agent run.
LLM_STREAMING=true

# ---------------------------------------------------------------- collection search MCP
COLLECTION_MCP_PORT=8085
SEARCH_MAX_RESULTS=8
SEARCH_SNIPPET_CHARS=1200

# ---------------------------------------------------------------- open-web MCP servers
DDG_SERVER_PORT=8889
DDG_SERVER_NAME=ddgs
DDG_DEFAULT_REGION=wt-wt
DDG_DEFAULT_MAX_RESULTS=3
DDG_DEFAULT_SAFESEARCH=off
DDG_DEFAULT_TIMELIMIT=
DDG_PROXY_URL=
DDG_TIMEOUT=30

WIKIPEDIA_SERVER_PORT=8093
WIKIPEDIA_LANGUAGE=en
WIKIPEDIA_MAX_RESULTS=3

WHOIS_SERVER_PORT=8092
WHOIS_RATE_LIMITING=true
WHOIS_RATE_LIMIT_MS=100

# Metasearch: one query to several engines, merged with reciprocal rank fusion.
# Every engine is an HTML scraper with no API key, so assume one will break; drop it from
# this list to turn it off without a rebuild. A response's `degraded` field names the
# engines that came back empty, which is how you find out.
METASEARCH_SERVER_PORT=8086
METASEARCH_ENGINES=ddg,brave,startpage,yahoo
METASEARCH_ENGINE_TIMEOUT=8
# RRF constant: score = sum of 1/(k + rank) over engines. 60 is the value from the
# original paper — larger flattens the difference between ranks further.
METASEARCH_RRF_K=60
METASEARCH_MAX_RESULTS=8
METASEARCH_SNIPPET_CHARS=400

# Browser: a real headless Chromium for pages the scrapers cannot read. The image is
# ~1 GB and that is expected. Only public http/https URLs are fetchable — the URL check
# in browser_use_server/urlcheck.py is what keeps an LLM-driven fetcher inside this
# network from reading clickhouse:8123, so do not loosen it.
BROWSER_SERVER_PORT=8087
BROWSER_NAV_TIMEOUT=30
BROWSER_SETTLE_SECONDS=1.5
BROWSER_MAX_LINKS=50
BROWSER_MAX_DOCUMENT_CHARS=20000

# ---------------------------------------------------------------- agents
INTERNAL_SEARCH_AGENT_PORT=9099
FULL_RESEARCH_AGENT_PORT=9090

# ---------------------------------------------------------------- tracing (optional)
# Leave empty to run without Langfuse. The /feedback endpoints return 503 when unset;
# chat works either way.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Thinking budget (research agent) -------------------------------------------
# Qwen3.5's template prefills <think></think> unless told otherwise, so `off` really
# means no thinking at all, not a small budget. Measured cost of turning it on is ~4x
# completion tokens. See hoover4_research_agent/README.md.
#   off       template prefills <think></think>. Fastest. Default.
#   on        unbounded reasoning. Slowest, best on multi-step questions.
#   budgeted  reasoning on, capped at AGENT_THINKING_BUDGET_TOKENS.
# Tool-calling turns never think whatever this is set to.
AGENT_THINKING=off
# Half a measured unbudgeted thought (~1,500 tokens).
AGENT_THINKING_BUDGET_TOKENS=750

# Compiled graphs kept in memory. Keyed by ACL *and* chat session, and each holds one
# live MCP connection per configured server, so this is a real resource cap.
AGENT_MAX_CACHED_GRAPHS=24

# --- Per-chat browser sessions --------------------------------------------------
# Each conversation gets its own Chromium browser context so cookies do not leak
# between chats. Dropped when the chat ends, or after this long idle.
BROWSER_SESSION_IDLE_SECONDS=3600
BROWSER_SESSION_REAP_INTERVAL=360
BROWSER_MAX_SESSIONS=32
